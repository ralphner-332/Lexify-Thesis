datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  name                 String
  role                 String    @default("STUDENT") // STUDENT, EXPERT, ADMIN
  isDemo               Boolean   @default(true)
  disclaimerAcceptedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("users")
}

model Question {
  id                 String   @id @default(uuid())
  code               String   @unique
  title              String
  scenario           String
  modelAnswer        String
  statutoryElements  String   @default("[]") // JSON string of required elements
  relevantProvisions String   @default("[]") // JSON string of legal citations
  conceptVariations  String   @default("[]") // JSON string of acceptable phrasing
  isActive           Boolean  @default(true)
  orderIndex         Int      @default(0)
  isDemo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("questions")
}

model Rubric {
  id          String            @id @default(uuid())
  name        String
  description String
  isDefault   Boolean           @default(false)
  isDemo      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  criteria    RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id            String   @id @default(uuid())
  rubricId      String
  rubric        Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name          String
  description   String
  weightPercent Float    @default(20.0)
  maxPoints     Float    @default(20.0)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("rubric_criteria")
}

model AgentVersion {
  id                 String    @id @default(uuid())
  versionTag         String    @unique // "V1", "V2", "V3"
  label              String
  description        String
  systemInstructions String
  skillsDefinition   String    @default("{}") // JSON string
  rubricSnapshot     String    @default("{}") // JSON snapshot of active rubric
  evaluationPatterns String    @default("{}") // JSON guidelines for IRAC & scoring
  modelConfig        String    @default("{}") // JSON string: { provider, modelId, temperature, topP, maxTokens }
  isLocked           Boolean   @default(false)
  isActive           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  lockedAt           DateTime?

  @@map("agent_versions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  details    String?  // JSON string
  isDemo     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
