datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  passwordHash         String
  name                 String
  role                 String              @default("STUDENT") // STUDENT, EXPERT, ADMIN
  isDemo               Boolean             @default(true)
  disclaimerAcceptedAt DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sessions             AssessmentSession[]
  evaluations          Evaluation[]
  expertEvaluations    ExpertEvaluation[]
  expertDrafts         ExpertDraft[]

  @@map("users")
}

model Question {
  id                 String   @id @default(uuid())
  code               String   @unique
  title              String
  scenario           String
  modelAnswer        String
  statutoryElements  String   @default("[]") // JSON string of required elements
  relevantProvisions String   @default("[]") // JSON string of legal citations
  conceptVariations  String   @default("[]") // JSON string of acceptable phrasing
  isActive           Boolean  @default(true)
  orderIndex         Int      @default(0)
  isDemo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("questions")
}

model Rubric {
  id          String            @id @default(uuid())
  name        String
  description String
  isDefault   Boolean           @default(false)
  isDemo      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  criteria    RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id            String   @id @default(uuid())
  rubricId      String
  rubric        Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name          String
  description   String
  weightPercent Float    @default(20.0)
  maxPoints     Float    @default(20.0)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("rubric_criteria")
}

model AgentVersion {
  id                 String       @id @default(uuid())
  versionTag         String       @unique // "V1", "V2", "V3"
  label              String
  description        String
  systemInstructions String
  skillsDefinition   String       @default("{}") // JSON string
  rubricSnapshot     String       @default("{}") // JSON snapshot of active rubric
  evaluationPatterns String       @default("{}") // JSON guidelines for IRAC & scoring
  modelConfig        String       @default("{}") // JSON string: { provider, modelId, temperature, topP, maxTokens }
  parentVersionId    String?      // Parent version reference for V1 -> V2 -> V3 lineage
  changelog          String       @default("[]") // JSON array of change records: [{ component, changeSummary, rationale, linkedRefinementIds, approver, timestamp }]
  isLocked           Boolean      @default(false)
  isActive           Boolean      @default(false)
  createdAt          DateTime     @default(now())
  lockedAt           DateTime?
  evaluations        Evaluation[]

  @@map("agent_versions")
}

model AssessmentSession {
  id                String               @id @default(uuid())
  studentId         String
  student           User                 @relation(fields: [studentId], references: [id])
  status            String               @default("IN_PROGRESS") // "IN_PROGRESS" | "SUBMITTED"
  questionsSnapshot String               @default("[]") // Authoritative JSON snapshot of full question objects
  startedAt         DateTime             @default(now())
  submittedAt       DateTime?
  isDemo            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  drafts            StudentAnswerDraft[]
  evaluations       Evaluation[]
  expertEvaluations ExpertEvaluation[]
  expertDrafts      ExpertDraft[]

  @@map("assessment_sessions")
}

model StudentAnswerDraft {
  id          String            @id @default(uuid())
  sessionId   String
  session     AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId  String
  answerText  String            @default("")
  updatedAt   DateTime          @updatedAt

  @@unique([sessionId, questionId])
  @@map("student_answer_drafts")
}

model Evaluation {
  id                  String            @id @default(uuid())
  sessionId           String
  session             AssessmentSession @relation(fields: [sessionId], references: [id])
  studentId           String
  student             User              @relation(fields: [studentId], references: [id])
  questionId          String
  agentVersionId      String
  agentVersion        AgentVersion      @relation(fields: [agentVersionId], references: [id])
  questionSnapshot    String            // Immutable JSON snapshot copied directly from AssessmentSession.questionsSnapshot
  modelConfigSnapshot String            // Immutable JSON snapshot of LLM settings at evaluation time
  rubricSnapshot      String            // Immutable JSON snapshot of rubric criteria and weights at evaluation time
  studentAnswer       String
  numericalScore      Float
  maxScore            Float             // Dynamically derived from rubric criteria maxPoints sum
  scoringBasis        String
  criterionScores     String            // JSON array: [{ criterionName, score, maxPoints, reasoning }]
  strengths           String            // JSON array of strings
  missingElements     String            // JSON array of strings
  areasForImprovement String            // JSON array of strings
  confidenceScore     Float             @default(1.0)
  reviewFlags         String            @default("[]") // JSON array of review flags
  isDemo              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  // Strictly NO updatedAt — append-only immutable evidence!

  @@map("evaluations")
}

model ExpertEvaluation {
  id                  String            @id @default(uuid())
  expertId            String
  expert              User              @relation(fields: [expertId], references: [id])
  sessionId           String
  session             AssessmentSession @relation(fields: [sessionId], references: [id])
  questionId          String
  studentAnswer       String
  numericalScore      Float
  maxScore            Float
  scoringBasis        String            // Expert comprehensive legal rationale
  criterionScores     String            // JSON array: [{ criterionName, score, maxPoints, reasoning }]
  qualitativeComments String            @default("")
  questionSnapshot    String            // Immutable JSON snapshot from session
  rubricSnapshot      String            // Immutable JSON snapshot of rubric criteria used
  isDemo              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  // Strictly NO updatedAt — append-only immutable evidence!

  @@unique([expertId, sessionId, questionId])
  @@map("expert_evaluations")
}

model ExpertDraft {
  id                  String            @id @default(uuid())
  expertId            String
  expert              User              @relation(fields: [expertId], references: [id])
  sessionId           String
  session             AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId          String
  numericalScore      Float             @default(0)
  scoringBasis        String            @default("")
  criterionScores     String            @default("[]")
  qualitativeComments String            @default("")
  updatedAt           DateTime          @updatedAt

  @@unique([expertId, sessionId, questionId])
  @@map("expert_drafts")
}

model RefinementLog {
  id                     String   @id @default(uuid())
  gapId                  String   @unique // e.g. "GAP-001"
  questionId             String?
  sessionId              String?
  aiEvaluationId         String?
  expertEvaluationId     String?
  agentVersionId         String   // e.g. "V1"
  targetComponent        String   // "SYSTEM_INSTRUCTIONS" | "EVALUATION_PATTERNS" | "RUBRIC_SNAPSHOT" | "CONCEPT_VARIATIONS" | "SKILLS_DEFINITION" | "OTHER"
  gapCategory            String   // "LEGAL_CONCEPT_MISUNDERSTANDING" | "STATUTORY_ELEMENT_OMISSION" | "REASONING_IRAC_ISSUE" | "ACCEPTABLE_VARIATION_HANDLING" | "SCORING_RUBRIC_INTERPRETATION" | "HALLUCINATION_UNSUPPORTED_CLAIM" | "REFERENCE_MATERIAL_GROUNDING" | "OTHER"
  discrepancyDescription String
  aiPosition             String   @default("")
  expertPosition         String   @default("")
  expertRationale        String   @default("")
  rootCauseAnalysis      String   @default("")
  proposedRefinement     String
  status                 String   @default("DRAFT") // "DRAFT" | "APPROVED" | "APPLIED" | "REJECTED"
  approvedDecision       String   @default("")
  resultingAgentVersionId String? // e.g. "V2" when applied
  researcherNotes        String   @default("")
  isDemo                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("refinement_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  details    String?  // JSON string
  isDemo     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
