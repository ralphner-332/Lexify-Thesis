datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  String                 @default("STUDENT") // STUDENT, EXPERT, ADMIN
  isDemo                Boolean                @default(true)
  disclaimerAcceptedAt  DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              AssessmentSession[]
  evaluations           Evaluation[]
  expertEvaluations     ExpertEvaluation[]
  expertDrafts          ExpertDraft[]
  finalReviews          FinalEvaluationReview[]
  surveyResponses       SurveyResponse[]

  @@map("users")
}

model Question {
  id                 String   @id @default(uuid())
  code               String   @unique
  title              String
  scenario           String
  modelAnswer        String
  statutoryElements  String   @default("[]") // JSON string of required elements
  relevantProvisions String   @default("[]") // JSON string of legal citations
  conceptVariations  String   @default("[]") // JSON string of acceptable phrasing
  testSet            String?  @default("TEST_1") // "TEST_1" | "TEST_2" | "TEST_3" | "TEST_4"
  isActive           Boolean  @default(true)
  orderIndex         Int      @default(0)
  isDemo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("questions")
}

model Rubric {
  id          String            @id @default(uuid())
  name        String
  description String
  isDefault   Boolean           @default(false)
  isDemo      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  criteria    RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id            String   @id @default(uuid())
  rubricId      String
  rubric        Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name          String
  description   String
  weightPercent Float    @default(20.0)
  maxPoints     Float    @default(20.0)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("rubric_criteria")
}

model AgentVersion {
  id                 String       @id @default(uuid())
  versionTag         String       @unique // "V1", "V2", "V3"
  label              String
  description        String
  systemInstructions String
  skillsDefinition   String       @default("{}") // JSON string
  rubricSnapshot     String       @default("{}") // JSON snapshot of active rubric
  evaluationPatterns String       @default("{}") // JSON guidelines for IRAC & scoring
  modelConfig        String       @default("{}") // JSON string: { provider, modelId, temperature, topP, maxTokens }
  parentVersionId    String?      // Parent version reference for V1 -> V2 -> V3 lineage
  changelog          String       @default("[]") // JSON array of change records: [{ component, changeSummary, rationale, linkedRefinementIds, approver, timestamp }]
  isLocked           Boolean      @default(false)
  isActive           Boolean      @default(false)
  createdAt          DateTime     @default(now())
  lockedAt           DateTime?
  evaluations        Evaluation[]

  @@map("agent_versions")
}

model AssessmentSession {
  id                String               @id @default(uuid())
  studentId         String
  student           User                 @relation(fields: [studentId], references: [id])
  status            String               @default("IN_PROGRESS") // "IN_PROGRESS" | "SUBMITTED"
  questionsSnapshot String               @default("[]") // Authoritative JSON snapshot of full question objects
  startedAt         DateTime             @default(now())
  submittedAt       DateTime?
  isDemo            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  drafts            StudentAnswerDraft[]
  evaluations       Evaluation[]
  expertEvaluations ExpertEvaluation[]
  expertDrafts      ExpertDraft[]

  @@map("assessment_sessions")
}

model StudentAnswerDraft {
  id          String            @id @default(uuid())
  sessionId   String
  session     AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId  String
  answerText  String            @default("")
  updatedAt   DateTime          @updatedAt

  @@unique([sessionId, questionId])
  @@map("student_answer_drafts")
}

model Evaluation {
  id                  String                 @id @default(uuid())
  sessionId           String
  session             AssessmentSession      @relation(fields: [sessionId], references: [id])
  studentId           String
  student             User                   @relation(fields: [studentId], references: [id])
  questionId          String
  agentVersionId      String
  agentVersion        AgentVersion           @relation(fields: [agentVersionId], references: [id])
  modelSlot           String                 @default("MODEL_A") // "MODEL_A" | "MODEL_B" | "MODEL_C"
  modelFamily         String                 @default("Llama 3.1") // "Llama 3.1" | "Mistral" | "Gemma 2"
  exactModelId        String                 @default("meta-llama/llama-3.1-8b-instruct")
  questionSnapshot    String                 // Immutable JSON snapshot copied directly from AssessmentSession.questionsSnapshot
  modelConfigSnapshot String                 // Immutable JSON snapshot of LLM settings at evaluation time
  rubricSnapshot      String                 // Immutable JSON snapshot of rubric criteria and weights at evaluation time
  studentAnswer       String
  numericalScore      Float
  maxScore            Float                  // Dynamically derived from rubric criteria maxPoints sum
  scoringBasis        String
  criterionScores     String                 // JSON array: [{ criterionName, score, maxPoints, reasoning }]
  strengths           String                 // JSON array of strings
  missingElements     String                 // JSON array of strings
  areasForImprovement String                 // JSON array of strings
  lexicalAnalysis     String                 @default("{}") // JSON string of lexical metrics
  semanticAnalysis    String                 @default("{}") // JSON string of semantic metrics
  confidenceScore     Float                  @default(1.0)
  reviewFlags         String                 @default("[]") // JSON array of review flags
  isDemo              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  finalReviews        FinalEvaluationReview[]
  // Strictly NO updatedAt — append-only immutable evidence!

  @@map("evaluations")
}

model ExpertEvaluation {
  id                  String            @id @default(uuid())
  expertId            String
  expert              User              @relation(fields: [expertId], references: [id])
  sessionId           String
  session             AssessmentSession @relation(fields: [sessionId], references: [id])
  questionId          String
  studentAnswer       String
  numericalScore      Float
  maxScore            Float
  scoringBasis        String            // Expert comprehensive legal rationale
  criterionScores     String            // JSON array: [{ criterionName, score, maxPoints, reasoning }]
  qualitativeComments String            @default("")
  questionSnapshot    String            // Immutable JSON snapshot from session
  rubricSnapshot      String            // Immutable JSON snapshot of rubric criteria used
  isDemo              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  // Strictly NO updatedAt — append-only immutable evidence!

  @@unique([expertId, sessionId, questionId])
  @@map("expert_evaluations")
}

model ExpertDraft {
  id                  String            @id @default(uuid())
  expertId            String
  expert              User              @relation(fields: [expertId], references: [id])
  sessionId           String
  session             AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId          String
  numericalScore      Float             @default(0)
  scoringBasis        String            @default("")
  criterionScores     String            @default("[]")
  qualitativeComments String            @default("")
  updatedAt           DateTime          @updatedAt

  @@unique([expertId, sessionId, questionId])
  @@map("expert_drafts")
}

model RefinementLog {
  id                     String   @id @default(uuid())
  gapId                  String   @unique // e.g. "GAP-001"
  questionId             String?
  sessionId              String?
  aiEvaluationId         String?
  expertEvaluationId     String?
  agentVersionId         String   // e.g. "V1"
  targetComponent        String   // "SYSTEM_INSTRUCTIONS" | "EVALUATION_PATTERNS" | "RUBRIC_SNAPSHOT" | "CONCEPT_VARIATIONS" | "SKILLS_DEFINITION" | "OTHER"
  gapCategory            String   // "LEGAL_CONCEPT_MISUNDERSTANDING" | "STATUTORY_ELEMENT_OMISSION" | "REASONING_IRAC_ISSUE" | "ACCEPTABLE_VARIATION_HANDLING" | "SCORING_RUBRIC_INTERPRETATION" | "HALLUCINATION_UNSUPPORTED_CLAIM" | "REFERENCE_MATERIAL_GROUNDING" | "OTHER"
  discrepancyDescription String
  aiPosition             String   @default("")
  expertPosition         String   @default("")
  expertRationale        String   @default("")
  rootCauseAnalysis      String   @default("")
  proposedRefinement     String
  status                 String   @default("DRAFT") // "DRAFT" | "APPROVED" | "APPLIED" | "REJECTED"
  approvedDecision       String   @default("")
  resultingAgentVersionId String? // e.g. "V2" when applied
  researcherNotes        String   @default("")
  isDemo                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("refinement_logs")
}

model FinalEvaluationReview {
  id                         String     @id @default(uuid())
  expertId                   String
  expert                     User       @relation(fields: [expertId], references: [id])
  evaluationId               String
  evaluation                 Evaluation @relation(fields: [evaluationId], references: [id])
  sessionId                  String
  questionId                 String
  agentVersionId             String     // e.g. "V3"
  agreementRating            Int        // 1-5 Likert scale (1: Strongly Disagree, 5: Strongly Agree)
  reasoningCorrectnessRating Int        // 1-5 Likert scale
  statutoryGroundingRating   Int        // 1-5 Likert scale
  recommendedScore           Float
  aiScore                    Float
  scoreDelta                 Float      // recommendedScore - aiScore
  errorTags                  String     @default("[]") // JSON array of error tag strings
  qualitativeComments        String     @default("")
  improvementSuggestions     String     @default("")
  finalVerdict               String     // "ACCEPTABLE" | "ACCEPTABLE_WITH_MINOR_ISSUES" | "REQUIRES_IMPROVEMENT"
  questionSnapshot           String     // JSON snapshot of question evaluated
  studentAnswer              String
  isDemo                     Boolean    @default(true)
  createdAt                  DateTime   @default(now())
  // Strictly NO updatedAt — append-only immutable evidence!

  @@unique([expertId, evaluationId])
  @@map("final_evaluation_reviews")
}

model SurveyQuestionnaire {
  id          String           @id @default(uuid())
  title       String
  description String
  targetRole  String           // "STUDENT" | "EXPERT"
  version     String           @default("1.0")
  isActive    Boolean          @default(true)
  isDemo      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  questions   SurveyQuestion[]
  responses   SurveyResponse[]

  @@map("survey_questionnaires")
}

model SurveyQuestion {
  id              String              @id @default(uuid())
  questionnaireId String
  questionnaire   SurveyQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  code            String              // e.g. "SQ-01", "EQ-01"
  prompt          String
  questionType    String              // "LIKERT_5" | "OPEN_TEXT" | "MULTIPLE_CHOICE"
  options         String              @default("[]") // JSON array of string options
  orderIndex      Int                 @default(0)
  isRequired      Boolean             @default(true)
  createdAt       DateTime            @default(now())

  @@map("survey_questions")
}

model SurveyResponse {
  id                    String              @id @default(uuid())
  questionnaireId       String
  questionnaire         SurveyQuestionnaire @relation(fields: [questionnaireId], references: [id])
  respondentId          String
  respondent            User                @relation(fields: [respondentId], references: [id])
  respondentRole        String              // "STUDENT" | "EXPERT"
  questionnaireSnapshot String              // Immutable JSON snapshot of questions at response time
  answers               String              // JSON object: { [questionId]: value }
  qualitativeNotes      String              @default("")
  isDemo                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  // Strictly NO updatedAt — append-only immutable evidence!

  @@map("survey_responses")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  details    String?  // JSON string
  isDemo     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model ModelConfigSetting {
  id                  String   @id @default(uuid())
  modelSlot           String   @unique // "MODEL_A" | "MODEL_B" | "MODEL_C"
  researchName        String   // "Meta Llama 3.2 3B", "Microsoft Phi-4-mini", "Google Gemma 2 2B"
  modelFamily         String   // "Llama 3.2", "Phi-4", "Gemma 2"
  parameterClass      String   // "3B", "3.8B", "2B"
  provider            String   @default("ollama") // "ollama" | "openrouter" | "custom"
  exactModelId        String   // e.g. "llama3.2:3b"
  endpointUrl         String?  // Optional custom endpoint URL
  apiKeyEnvVar        String   @default("LOCAL_INFERENCE")
  temperature         Float    @default(0.2)
  topP                Float    @default(0.95)
  maxTokens           Int      @default(2048)
  systemInstructions  String   @default("")
  isLocked            Boolean  @default(false)
  isDemo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("model_config_settings")
}

model SystemSetting {
  id                  String   @id @default("global")
  studentDisplayModel String   @default("MODEL_A") // "MODEL_A" | "MODEL_B" | "MODEL_C"
  accuracyLevel       String   @default("STANDARD") // "STRICT" | "STANDARD" | "LENIENT"
  activeTestSet       String   @default("TEST_1")   // "TEST_1" | "TEST_2" | "TEST_3" | "TEST_4"
  testSetStatuses     String   @default("{\"TEST_1\":\"ACTIVE\",\"TEST_2\":\"DRAFT\",\"TEST_3\":\"DRAFT\",\"TEST_4\":\"DRAFT\"}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}

